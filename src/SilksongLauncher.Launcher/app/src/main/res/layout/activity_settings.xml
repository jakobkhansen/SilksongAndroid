<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings screen, same dark palette as the launcher. Vertical stack of rows,
  each a control with a one-line note under it, and a Back button at the
  bottom. Sized for the Ayn Thor's landscape display; wrapped in a ScrollView
  so the lower rows and the Back button cannot be pushed off-screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <Switch
        android:id="@+id/sw_auto_pull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_auto_pull"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_auto_pull_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp" />

    <Switch
        android:id="@+id/sw_auto_push"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_auto_push"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_auto_push_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp" />

    <Switch
        android:id="@+id/sw_skip_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_skip_intro"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_skip_intro_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp" />

    <Switch
        android:id="@+id/sw_perf_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_perf_overlay"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_perf_overlay_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp" />

    <!-- ───── Dual screen ───── -->

    <Switch
        android:id="@+id/sw_dual_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_dual_screen"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_dual_screen_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="4dp" />

    <!-- ───── Wide aspect ───── -->

    <Switch
        android:id="@+id/sw_wide_aspect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_wide_aspect"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_wide_aspect_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="4dp" />

    <!-- ───── Clear the build ─────
         Last, and visually separated, because it is the only control here
         that destroys anything. -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_dim"
        android:alpha="0.3"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_clear_build"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_build"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/hornet_red_dim"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_settings_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_logs"
            android:textSize="15sp"
            android:textColor="@color/text_on_control"
            android:backgroundTint="@color/surface_control"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:minHeight="0dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_clear_build_subtitle"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="4dp" />

    <Button
        android:id="@+id/btn_settings_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/settings_back"
        android:textSize="14sp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:minHeight="0dp" />
</LinearLayout>
</ScrollView>
